# CareHome Clocking - Environment Variables
# Copy this file to .env and configure

# ===========================================
# DATABASE
# ===========================================
DB_ROOT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_NAME=carehome
DB_USER=frappe
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ===========================================
# SITE CONFIGURATION
# ===========================================
FRAPPE_SITE_NAME=carehome.local
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# ===========================================
# ENCRYPTION (for TOTP secrets)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ===========================================
ENCRYPTION_KEY=GENERATE_THIS_32_BYTE_KEY

# ===========================================
# PORTS
# ===========================================
HTTP_PORT=8080

# ===========================================
# PRODUCTION SETTINGS
# ===========================================
# Domain for production (used by nginx & certbot)
DOMAIN=carehome.example.com

# Let's Encrypt email for SSL certificates
LETSENCRYPT_EMAIL=admin@example.com

# ===========================================
# FRAPPE SETTINGS
# ===========================================
FRAPPE_SITE_NAME_HEADER=carehome.local
