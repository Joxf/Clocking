{
  "name": "Shift Swap Request",
  "module": "Carehome Clocking",
  "doctype": "DocType",
  "engine": "InnoDB",
  "naming_rule": "Expression",
  "autoname": "SWAP-.YYYY.-.#####",
  "fields": [
    {
      "fieldname": "requester",
      "fieldtype": "Link",
      "label": "Requester",
      "options": "Employee",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "requester_name",
      "fieldtype": "Data",
      "label": "Requester Name",
      "fetch_from": "requester.employee_name",
      "read_only": 1
    },
    {
      "fieldname": "requester_shift",
      "fieldtype": "Link",
      "label": "Requester's Shift",
      "options": "Shift Assignment"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "target_employee",
      "fieldtype": "Link",
      "label": "Target Employee",
      "options": "Employee",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "target_name",
      "fieldtype": "Data",
      "label": "Target Name",
      "fetch_from": "target_employee.employee_name",
      "read_only": 1
    },
    {
      "fieldname": "target_shift",
      "fieldtype": "Link",
      "label": "Target's Shift",
      "options": "Shift Assignment"
    },
    {
      "fieldname": "section_details",
      "fieldtype": "Section Break",
      "label": "Swap Details"
    },
    {
      "fieldname": "swap_date",
      "fieldtype": "Date",
      "label": "Swap Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Proposed\nAccepted\nDeclined\nApproved\nRejected\nCancelled",
      "default": "Proposed",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "care_home",
      "fieldtype": "Link",
      "label": "Care Home",
      "options": "Care Home"
    },
    {
      "fieldname": "section_notes",
      "fieldtype": "Section Break",
      "label": "Notes"
    },
    {
      "fieldname": "requester_notes",
      "fieldtype": "Small Text",
      "label": "Requester Notes"
    },
    {
      "fieldname": "target_notes",
      "fieldtype": "Small Text",
      "label": "Target Notes"
    },
    {
      "fieldname": "manager_notes",
      "fieldtype": "Small Text",
      "label": "Manager Notes"
    },
    {
      "fieldname": "section_approval",
      "fieldtype": "Section Break",
      "label": "Approval"
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Link",
      "label": "Approved/Rejected By",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "approved_at",
      "fieldtype": "Datetime",
      "label": "Approved/Rejected At",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    },
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Care Home Manager",
      "read": 1,
      "write": 1,
      "create": 1
    },
    {
      "role": "Employee",
      "read": 1,
      "write": 1,
      "create": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1
}
